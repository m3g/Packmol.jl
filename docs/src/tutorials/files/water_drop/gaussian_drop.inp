#
# A drop of water on graphite with the shape of a Gaussian: below the surface
# z = 2 + 25 exp(-r^2 / (2 * 15^2)), above the plane z = 2 (r is the distance
# from the z axis). Far from the axis the Gaussian region is a film too thin for
# a water molecule, so the drop is also kept inside a cylinder with a radius of
# 35 Å, which contains about 33000 Å³ of the drop (1050 water molecules, 1 g/mL).
#
tolerance 2.0
output gaussian_drop.pdb

structure graphite.pdb
  number 1
  fixed 0. 0. 0. 0. 0. 0.
end structure

structure water.pdb
  number 1050
  below radial_gaussian 0. 0. 1. 0. 0. 0. 2. 25. 15.
  above plane 0. 0. 1. 2.
  inside cylinder 0. 0. 0. 0. 0. 1. 35. 40.
end structure
