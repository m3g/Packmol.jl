#
# Larger POPC nanoliposome with water inside and outside
#
tolerance 2.0
output large.pdb

# Truncated octahedron periodic cell centered at the origin, with at least 10 Å of
# water between the nanoliposome and the faces of the cell. The output is written in
# the shape of the octahedron
pbc octahedral 0. 0. 0. 216.
periodic_boundary_style octahedral

# Water inside the nanoliposome: a sphere of radius 37 Å
structure water.pdb
  number 7096
  inside sphere 0. 0. 0. 37.
end structure

# Inner leaflet: the heads (atom 1, N) inside the sphere of radius 40 Å, pointing to
# the water inside, and the ends of the chains (atoms 88 and 131) outside the sphere
# of radius 62 Å, near the middle of the bilayer (r = 68 Å)
structure popc.pdb
  number 377
  atoms 1
    inside sphere 0. 0. 0. 40.
  end atoms
  atoms 88 131
    outside sphere 0. 0. 0. 62.
  end atoms
end structure

# Outer leaflet: the ends of the chains inside the sphere of radius 74 Å, and the
# heads outside the sphere of radius 96 Å, pointing to the water outside
structure popc.pdb
  number 1090
  atoms 88 131
    inside sphere 0. 0. 0. 74.
  end atoms
  atoms 1
    outside sphere 0. 0. 0. 96.
  end atoms
end structure

# Water outside the nanoliposome, filling the rest of the periodic cell
structure water.pdb
  number 127604
  outside sphere 0. 0. 0. 98.
end structure
