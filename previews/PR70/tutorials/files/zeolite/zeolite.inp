#
# Methane and carbon dioxide in the cages of the chabazite zeolite (CHA):
# 2 x 2 x 2 hexagonal unit cells of the IZA database structure (24 cages), with
# 3 molecules of carbon dioxide and 1 of methane per cage (4.2 and 1.4 mmol/g),
# in the triclinic periodic cell of the zeolite (a = b = 27.35 Å, c = 29.534 Å,
# gamma = 120 degrees).
#
tolerance 2.0
output zeolite.pdb
unitcell 27.350 27.350 29.534 90. 90. 120.

# Uncomment to write only the initial placement of the molecules to the output file,
# without packing them (to check the constraints):
# check_initial_placement

# The zeolite, kept at the coordinates of the file (centered at the origin, as
# the cell). The radius of the atoms (1.5 Å, here and in the gases) keeps the
# atoms of the gases 3 Å away from those of the framework, a contact distance
# (with the tolerance alone, they could get 2 Å from the oxygen atoms).
structure cha.pdb
  number 1
  fixed 0. 0. 0. 0. 0. 0.
  radius 1.5
end structure

structure methane.pdb
  number 24
  radius 1.5
end structure

structure co2.pdb
  number 72
  radius 1.5
end structure
