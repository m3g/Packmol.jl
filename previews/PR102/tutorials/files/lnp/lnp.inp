# Compartment 1: the RNA (fixed at the center) and water
structure rna1.cif
  number 1
  center
  fixed 0.0 0.0 150.0 0. 0. 0.
end structure

structure wt4.pdb
  number 11970
  inside sphere 0.0 0.0 150.0 102.0
end structure

# Compartment 2: the RNA (fixed at the center) and water
structure rna2.cif
  number 1
  center
  fixed -130.0 0.0 -75.0 0. 0. 0.
end structure

structure wt4.pdb
  number 8884
  inside sphere -130.0 0.0 -75.0 92.0
end structure

# Compartment 3: the RNA (fixed at the center) and water
structure rna3.cif
  number 1
  center
  fixed 130.0 0.0 -75.0 0. 0. 0.
end structure

structure wt4.pdb
  number 6299
  inside sphere 130.0 0.0 -75.0 82.0
end structure

# The lipid phase: POPC without orientation, between the monolayers (with its radii
# scaled by 5 at the start, as those of the monolayers, the first loop of the packing
# did not finish in 10 minutes)
structure popc.pdb
  number 138077
  inside sphere 0. 0. 0. 388.0
  outside sphere 0.0 0.0 150.0 113.0
  outside sphere -130.0 0.0 -75.0 103.0
  outside sphere 130.0 0.0 -75.0 93.0
end structure

# Outside: water
structure wt4.pdb
  number 689515
  outside sphere 0. 0. 0. 397.0
end structure
