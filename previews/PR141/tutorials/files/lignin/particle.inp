#
# A particle of lignin: 70 oligomers of spruce lignin (7 copies of 10 of them, built with
# LigninBuilder), in a sphere of 34 Å, at 1.19 g/cm³. The oligomers are flexible (every
# rotatable bond found from their bonds turns, `rotatable all`), and the particle is too
# dense to pack from a random placement: it is packed at half the density, and
# compressed (`use_compression`).
#
tolerance 2.0
output particle.pdb
use_compression 0.5

# To write only the initial placement of the molecules to the output file,
# without packing them (to check the constraints), uncomment the line below.
# check_initial_placement

structure lignin_L3.pdb
  number 7
  rotatable all
  inside sphere 0. 0. 0. 34.
end structure

structure lignin_L5.pdb
  number 7
  rotatable all
  inside sphere 0. 0. 0. 34.
end structure

