#
# The monolayers of a lipid nanoparticle of 80 nm (SIRAH coarse-grained lipids of the
# Zika example): the outer monolayer, heads outwards, and those of three compartments,
# heads inwards; the chains point to the lipid phase between them.
#
tolerance 2.0
radscale 5.0
output monolayers.cif

# To write only the initial placement of the molecules to the output file,
# without packing them (to check the constraints), uncomment the line below.
# check_initial_placement

# The outer monolayer: heads beyond 395.0, ends of the chains within 388.0
structure popc.pdb
  number 16216
  atoms 1
    outside sphere 0. 0. 0. 395.0
  end atoms
  atoms 16
    inside sphere 0. 0. 0. 388.0
  end atoms
end structure

structure pope.pdb
  number 8108
  atoms 1
    outside sphere 0. 0. 0. 395.0
  end atoms
  atoms 16
    inside sphere 0. 0. 0. 388.0
  end atoms
end structure

structure pops.pdb
  number 2703
  atoms 1
    outside sphere 0. 0. 0. 395.0
  end atoms
  atoms 17
    inside sphere 0. 0. 0. 388.0
  end atoms
end structure

