#
# The lignin particle (the output of particle.inp), fixed at the center of a periodic
# cube of 100 Å, in a mixture of acetone and water (30:70 by volume).
#
tolerance 2.0
output lignin.pdb
pbc -50. -50. -50. 50. 50. 50.

# To write only the initial placement of the molecules to the output file,
# without packing them (to check the constraints), uncomment the line below.
# check_initial_placement

# The particle, fixed where it was packed
structure particle.pdb
  number 1
  fixed 0. 0. 0. 0. 0. 0.
end structure

# The solvent fills the rest of the cell
structure water.pdb
  number 19548
end structure

structure acetone.pdb
  number 2039
end structure
